# Backend API (main.py) and background worker (worker.py) both read these via config.py.
# Names only - never commit real values. Copy to .env for local runs.
# On Render, set the same names on BOTH "Ai Vastra Backend 2.3" and "Ai Vastra Worker 2.3".

# --- Required (the app will not start without these) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# --- Needed in production (checked by GET /healthz) ---
ADMIN_PANEL_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
MASTER_SHOP_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
FAL_KEY=

# --- Optional (safe defaults in config.py) ---
APP_ENV=
GEMINI_IMAGE_MODEL_ID=
CREDITS_PER_IMAGE=
WHATSAPP_FREE_IMAGES=
WORKER_POLL_INTERVAL_SECONDS=
WHATSAPP_GRAPH_VERSION=
# false locally, leave unset or true on Render
WHATSAPP_WATCHER_ENABLED=

# --- Admin panel ---
# The admin panel (Vite) reads its own file: adminPanel/.env (see adminPanel/.env.example):
# VITE_ADMIN_API_BASE_URL, VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY
